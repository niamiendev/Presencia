{
  "expo": {
    "name": "Presencia",
    "slug": "Presencia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "/assets/logo.png",
    "scheme": "presencia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "/assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "/assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "/assets/logo.png",
          "imageWidth": 76
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "L'application a besoin d'accéder à vos photos.",
          "cameraPermission": "L'application a besoin d'accéder à votre caméra.",
          "colors": {
            "cropToolbarColor": "#000000"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#000000"
            }
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La position sert à enregistrer l'emplacement du site."
        }
      ],
      "expo-image",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
